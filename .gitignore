# Dependencies
node_modules/
npm-debug.log*

# Database (스키마/시딩스크립트는 추적하되, 실제 데이터 파일은 제외)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# 업로드된 거래내역 임시 파일 (multer가 저장하는 곳, 처리 후 삭제되지만 혹시 남는 경우 대비)
data/uploads/*
!data/uploads/.gitkeep

# 환경변수 / 비밀값 (지금은 안 쓰지만 3단계에서 SMS API 키 등 추가될 수 있음)
.env
.env.local

# OS / 에디터
.DS_Store
*.log

# 빌드 산출물 (해당 시)
dist/
build/
