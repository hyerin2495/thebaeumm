<%- include('../partials/header') %>

<div class="toolbar">
  <form class="filter-bar" method="GET" action="/students" id="filterForm">
    <input type="text" name="keyword" placeholder="학생명 / 학부모명 / 연락처" value="<%= filters.keyword %>" style="min-width:180px;">
    <select name="school">
      <option value="">전체 학교</option>
      <% schoolList.forEach(s => { %>
        <option value="<%= s.school_name %>" <%= filters.school === s.school_name ? 'selected' : '' %>><%= s.school_name %></option>
      <% }) %>
    </select>
    <select name="grade">
      <option value="">전체 학년</option>
      <% gradeList.forEach(g => { %>
        <option value="<%= g.grade %>" <%= filters.grade === g.grade ? 'selected' : '' %>><%= g.grade %></option>
      <% }) %>
    </select>
    <select name="class_name">
      <option value="">전체 반</option>
      <% classList.forEach(c => { %>
        <option value="<%= c.class_name %>" <%= filters.class_name === c.class_name ? 'selected' : '' %>><%= c.class_name %></option>
      <% }) %>
    </select>
    <select name="status">
      <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>재원중</option>
      <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>퇴원</option>
      <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>전체</option>
    </select>
    <button type="submit" class="btn btn-secondary btn-sm">검색</button>
  </form>
  <div style="display:flex; gap:8px; flex-wrap:wrap;">
    <button type="button" class="btn btn-secondary" id="filterSmsBtn">
      조건 전체 발송 (<%= pagination.total %>명)
    </button>
    <a href="/students/import" class="btn btn-secondary">엑셀 일괄등록</a>
    <a href="/students/new" class="btn btn-primary">+ 학생 등록</a>
  </div>
</div>

<!-- 수신자 선택 영역 (iMessage 스타일) -->
<div id="recipientBar" style="display:none; background:#fff; border:1px solid var(--teal-500); border-radius:var(--radius-md); padding:14px 18px; margin-bottom:16px; box-shadow:0 2px 8px rgba(31,150,144,0.12);">
  <div style="display:flex; align-items:flex-start; gap:12px; flex-wrap:wrap;">
    <span style="font-size:13px; font-weight:600; color:var(--text-secondary); white-space:nowrap; padding-top:4px;">받는 사람</span>
    <div id="recipientChips" style="display:flex; flex-wrap:wrap; gap:6px; flex:1; min-width:0;"></div>
    <button type="button" id="openSmsBtn" class="btn btn-primary btn-sm" style="white-space:nowrap;">
      ✉ SMS 발송
    </button>
    <button type="button" id="clearAllBtn" class="btn btn-secondary btn-sm" style="white-space:nowrap;">
      전체 해제
    </button>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2>학생 목록</h2>
    <span class="text-muted" style="font-size:13px;">총 <%= pagination.total.toLocaleString() %>명</span>
  </div>

  <% if (students.length === 0) { %>
    <div class="empty-state">
      <div class="icon">▤</div>
      <p>조건에 맞는 학생이 없습니다.</p>
    </div>
  <% } else { %>
  <table class="data-table">
    <thead>
      <tr>
        <th class="checkbox-cell"><input type="checkbox" id="checkAll"></th>
        <th>학생명</th>
        <th>학교</th>
        <th>학년</th>
        <th>반</th>
        <th>학부모명</th>
        <th>학부모 연락처</th>
        <th class="center">상태</th>
        <th class="center">미납</th>
        <th class="center">관리</th>
      </tr>
    </thead>
    <tbody>
      <% students.forEach(s => { %>
      <tr>
        <td class="checkbox-cell">
          <input type="checkbox" class="row-check" value="<%= s.id %>" data-name="<%= s.name %>">
        </td>
        <td><strong><%= s.name %></strong></td>
        <td class="text-muted"><%= s.school_name || '-' %></td>
        <td class="text-muted"><%= s.grade || '-' %></td>
        <td class="text-muted"><%= s.class_name || '-' %></td>
        <td><%= s.parent_name || '-' %></td>
        <td><%= s.parent_phone %></td>
        <td class="center">
          <span class="badge badge-<%= s.status %>"><%= s.status === 'active' ? '재원중' : '퇴원' %></span>
        </td>
        <td class="center">
          <% if (s.overdue_count > 0) { %>
            <span class="badge badge-overdue"><%= s.overdue_count %>건</span>
          <% } else { %>
            <span class="text-muted">-</span>
          <% } %>
        </td>
        <td class="center">
          <a href="/students/<%= s.id %>/edit" class="btn btn-secondary btn-sm">수정</a>
          <% if (s.status === 'active') { %>
            <form action="/students/<%= s.id %>/deactivate" method="POST" style="display:inline;" onsubmit="return confirm('<%= s.name %> 학생을 퇴원 처리하시겠습니까?');">
              <button type="submit" class="btn btn-danger btn-sm">퇴원</button>
            </form>
          <% } else { %>
            <form action="/students/<%= s.id %>/reactivate" method="POST" style="display:inline;">
              <button type="submit" class="btn btn-secondary btn-sm">복귀</button>
            </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<% if (pagination.totalPages > 1) { %>
<div class="pagination">
  <% for (let p = 1; p <= pagination.totalPages; p++) { %>
    <% const qs = new URLSearchParams({...filters, page: p}).toString(); %>
    <% if (p === pagination.page) { %>
      <span class="current"><%= p %></span>
    <% } else { %>
      <a href="/students?<%= qs %>"><%= p %></a>
    <% } %>
  <% } %>
</div>
<% } %>

<!-- SMS 작성 모달 -->
<div id="smsModal" class="modal-overlay">
  <div class="modal-box" style="width:540px;">
    <div class="modal-header">
      <h3>✉ 문자 발송</h3>
      <button type="button" class="modal-close" id="smsModalClose">✕</button>
    </div>
    <div class="modal-body">

      <!-- 받는 사람 -->
      <div style="margin-bottom:16px;">
        <div style="font-size:12px; font-weight:600; color:var(--text-secondary); margin-bottom:8px;">받는 사람</div>
        <div id="modalRecipientChips" style="display:flex; flex-wrap:wrap; gap:6px; min-height:36px; background:#f4f6f8; border-radius:var(--radius-sm); padding:8px 10px;"></div>
      </div>

      <!-- 메시지 -->
      <div class="form-group" style="margin-bottom:0;">
        <label for="smsMessage">메시지</label>
        <textarea id="smsMessage" rows="6" placeholder="발송할 메시지를 입력하세요.&#10;&#10;예시:&#10;안녕하세요, {학생명} 학부모님.&#10;이번 달 교재비 안내드립니다."></textarea>
        <div class="form-help" style="margin-top:6px;"><strong>{학생명}</strong> 은 각 학생 이름으로 자동 치환됩니다.</div>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" id="smsModalCancelBtn" class="btn btn-secondary">취소</button>
      <button type="button" id="smsModalSendBtn" class="btn btn-primary">발송하기</button>
    </div>
  </div>
</div>

<!-- 발송 form -->
<form id="smsBulkForm" action="/students/send-sms-bulk" method="POST" style="display:none;">
  <input type="hidden" name="message" id="smsBulkMessage">
  <input type="hidden" name="send_mode" id="smsBulkMode">
  <input type="hidden" name="filter_school" value="<%= filters.school %>">
  <input type="hidden" name="filter_grade" value="<%= filters.grade %>">
  <input type="hidden" name="filter_class" value="<%= filters.class_name %>">
  <input type="hidden" name="filter_status" value="<%= filters.status %>">
</form>

<style>
.recipient-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: var(--teal-500);
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  padding: 4px 10px 4px 12px;
  border-radius: 999px;
  cursor: default;
}
.recipient-chip .chip-remove {
  background: rgba(255,255,255,0.3);
  border: none;
  color: #fff;
  width: 16px; height: 16px;
  border-radius: 50%;
  font-size: 11px;
  line-height: 1;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  padding: 0;
}
.recipient-chip .chip-remove:hover { background: rgba(255,255,255,0.5); }
.modal-recipient-chip {
  display: inline-flex;
  align-items: center;
  background: var(--teal-500);
  color: #fff;
  font-size: 12.5px;
  font-weight: 600;
  padding: 4px 12px;
  border-radius: 999px;
}
</style>

<script>
  const recipientBar   = document.getElementById('recipientBar');
  const recipientChips = document.getElementById('recipientChips');
  const modalChips     = document.getElementById('modalRecipientChips');
  const openSmsBtn     = document.getElementById('openSmsBtn');
  const clearAllBtn    = document.getElementById('clearAllBtn');
  const filterSmsBtn   = document.getElementById('filterSmsBtn');
  const smsModal       = document.getElementById('smsModal');
  const smsMessage     = document.getElementById('smsMessage');
  const smsBulkForm    = document.getElementById('smsBulkForm');
  const smsBulkMode    = document.getElementById('smsBulkMode');
  const smsBulkMessage = document.getElementById('smsBulkMessage');
  const checkAll       = document.getElementById('checkAll');
  const rowChecks      = document.querySelectorAll('.row-check');

  let sendMode = 'selected';

  // ---------- 체크박스 ----------
  function getChecked() {
    return Array.from(rowChecks).filter(c => c.checked);
  }

  function renderChips() {
    const checked = getChecked();
    recipientChips.innerHTML = '';

    checked.forEach(c => {
      const chip = document.createElement('span');
      chip.className = 'recipient-chip';
      chip.innerHTML = `${c.dataset.name}<button class="chip-remove" data-id="${c.value}" title="제거">✕</button>`;
      chip.querySelector('.chip-remove').addEventListener('click', () => {
        document.querySelector(`.row-check[value="${c.value}"]`).checked = false;
        updateAll();
      });
      recipientChips.appendChild(chip);
    });

    recipientBar.style.display = checked.length > 0 ? 'block' : 'none';
    if (checkAll) checkAll.checked = rowChecks.length > 0 && Array.from(rowChecks).every(c => c.checked);
  }

  function updateAll() {
    renderChips();
  }

  if (checkAll) {
    checkAll.addEventListener('change', () => {
      rowChecks.forEach(c => c.checked = checkAll.checked);
      updateAll();
    });
  }
  rowChecks.forEach(c => c.addEventListener('change', updateAll));

  clearAllBtn.addEventListener('click', () => {
    rowChecks.forEach(c => c.checked = false);
    if (checkAll) checkAll.checked = false;
    updateAll();
  });

  // ---------- 선택 학생 SMS ----------
  function openModal(mode) {
    sendMode = mode;
    smsMessage.value = '';
    modalChips.innerHTML = '';

    if (mode === 'selected') {
      getChecked().forEach(c => {
        const chip = document.createElement('span');
        chip.className = 'modal-recipient-chip';
        chip.textContent = c.dataset.name;
        modalChips.appendChild(chip);
      });
    } else {
      const chip = document.createElement('span');
      chip.className = 'modal-recipient-chip';
      chip.textContent = '현재 조건 전체 <%= pagination.total %>명';
      modalChips.appendChild(chip);
    }

    smsModal.classList.add('open');
    setTimeout(() => smsMessage.focus(), 100);
  }

  openSmsBtn.addEventListener('click', () => {
    if (getChecked().length === 0) return;
    openModal('selected');
  });

  filterSmsBtn.addEventListener('click', () => openModal('filter'));

  [document.getElementById('smsModalClose'), document.getElementById('smsModalCancelBtn')].forEach(el => {
    el.addEventListener('click', () => smsModal.classList.remove('open'));
  });

  document.getElementById('smsModalSendBtn').addEventListener('click', () => {
    const msg = smsMessage.value.trim();
    if (!msg) { alert('메시지를 입력해주세요.'); return; }

    const count = sendMode === 'selected' ? getChecked().length : <%= pagination.total %>;
    if (!confirm(`${count}명에게 문자를 발송하시겠습니까?`)) return;

    smsBulkMessage.value = msg;
    smsBulkMode.value = sendMode;

    smsBulkForm.querySelectorAll('input[name="student_ids"]').forEach(el => el.remove());
    if (sendMode === 'selected') {
      getChecked().forEach(c => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'student_ids';
        input.value = c.value;
        smsBulkForm.appendChild(input);
      });
    }

    smsBulkForm.submit();
  });
</script>

<%- include('../partials/footer') %>
