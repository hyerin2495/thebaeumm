<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle ? pageTitle + ' - EduBill' : 'EduBill 관리 시스템' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="app-shell">
  <%- include('sidebar', { active: active, adminName: adminName, adminRole: adminRole }) %>
  <div class="main-area">
    <div class="topbar">
      <div>
        <h1><%= pageTitle %></h1>
        <% if (typeof breadcrumb !== 'undefined' && breadcrumb) { %>
          <div class="breadcrumb"><%= breadcrumb %></div>
        <% } %>
      </div>
    </div>
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="flash <%= flash.type %>"><%= flash.message %></div>
    <% } %>
    <div class="content">
